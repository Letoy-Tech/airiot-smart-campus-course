# Backend template environment example
# Copy this file to your local environment manager or shell profile.
# Do not commit real secrets.

# Server
SERVER_PORT=8001
SERVER_CONTEXT_PATH=/api

# Database
DB_URL=jdbc:mysql://127.0.0.1:3306/backend_template?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me
DB_POOL_NAME=backend-template-pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=1800000
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_VALIDATION_TIMEOUT=5000
DB_CONNECTION_TEST_QUERY=SELECT 1

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_TIMEOUT=5000

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_WEB=INFO
LOG_LEVEL_MYBATIS=INFO

# Security
SECURITY_API_RULE_SYNC_REDIS=false
WHITELIST_STRICT_MODE=false
WHITELIST_ALLOW_BUSINESS_APIS=false

# JWT
JWT_SECRET=change-this-jwt-secret-to-a-64-plus-char-production-safe-value-1234567890
JWT_ISSUER=backend-template
JWT_ACCESS_TOKEN_EXPIRATION=43200000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000
JWT_REVOCATION_STRATEGY=VERSION
JWT_LEGACY_MODE=false
JWT_BLACKLIST_KEY_PREFIX=JWT:BLACKLIST:
JWT_BLACKLIST_CHECK_ENABLED=false

# Flyway
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

# Aliyun
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SMS_SIGN_NAME=
ALIBABA_CLOUD_SMS_REGION=cn-hongkong
ALIBABA_CLOUD_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIBABA_CLOUD_GLOBAL_SMS_REGION=cn-hangzhou
ALIBABA_CLOUD_GLOBAL_SMS_DOMAIN=dysmsapi.aliyuncs.com
ALIBABA_CLOUD_CAPTCHA_ENDPOINT=captcha.cn-shanghai.aliyuncs.com
ALIBABA_CLOUD_CAPTCHA_SCENE_ID=
ALIBABA_CLOUD_LOGIN_TEMPLATE_CODE=
ALIBABA_CLOUD_BIND_PHONE_TEMPLATE_CODE=
ALIBABA_CLOUD_RESET_PHONE_TEMPLATE_CODE=
ALIBABA_CLOUD_CONNECT_TIMEOUT=5000
ALIBABA_CLOUD_READ_TIMEOUT=5000

# Spring AI / DashScope
SPRING_AI_CHAT_MODEL=openai
SPRING_AI_EMBEDDING_MODEL=none
SPRING_AI_MODERATION_MODEL=none
SPRING_AI_AUDIO_SPEECH_MODEL=none
SPRING_AI_AUDIO_TRANSCRIPTION_MODEL=none
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
QWEN_API_KEY=
DASHSCOPE_MODEL=qwen3-vl-flash
DASHSCOPE_TEMPERATURE=0.7
DASHSCOPE_MAX_TOKENS=2000
