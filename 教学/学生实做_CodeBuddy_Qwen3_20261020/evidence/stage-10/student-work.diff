+  canAdmin,
+  (value) => {
+    if (!value) return
+    void load()
+  },
+  { immediate: true },
+)
+watch(
+  () => store.user?.uid ?? '',
+  () => {
+    status.value = null
+    hasData.value = false
+    written.value = ''
+    if (canAdmin.value) void load()
+  },
+)
+</script>
