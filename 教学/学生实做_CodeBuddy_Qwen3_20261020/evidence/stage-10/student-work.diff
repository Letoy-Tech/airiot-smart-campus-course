+  if (!canAdmin.value || busy.value) return
+  written.value = ''
+  const ok = await scope.run(
+    (signal) => getIntegration(signal),
+    (data) => {
+      status.value = data
+      hasData.value = true
+    },
+    (reason) => {
+      written.value = failureHint(reason)
+    },
+  )
+  if (!ok && !written.value) written.value = error.value || '接入状态读取未完成，请核对身份与教学服务。'
+}
