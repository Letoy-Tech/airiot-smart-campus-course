+# 第08课：接入本机课程 MySQL（Docker 容器 campus-v2-mysql），只在 127.0.0.1 内部使用。
+spring.application.name=campus-v2-backend
+
+server.address=127.0.0.1
+server.port=8098
+
+# 1) 口令放在项目根 .env（不提交、不复制进本文件、不写进代码）。
+#    这里把 .env 导入为属性来源；optional: 只作用于“文件导入”这一步，文件不存在时导入环节不报错。
+#    下面的数据源密码 ${DB_PASSWORD} 与 Flyway 迁移仍然需要真实配置和可用的 MySQL：
+#    第08课启动依然要求本机已有 .env 且本课程 MySQL 健康，不承诺缺配置也能启动。
+#    路径相对“运行目录”：在 backend 目录启动时 ../.env 即项目根。
+spring.config.import=optional:file:../.env[.properties]
+
+# 2) 课程容器：127.0.0.1:23501 → 容器内 3306；库 campus_course，账号 campus。
+#    sslMode=DISABLED + allowPublicKeyRetrieval：本机回环连接，避免 caching_sha2 握手被拒。
+spring.datasource.url=jdbc:mysql://127.0.0.1:23501/campus_course?sslMode=DISABLED&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
+spring.datasource.username=campus
+spring.datasource.password=${DB_PASSWORD}
+spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
+
+# 3) 课堂单人本机够用的连接池，避免默认 10 个连接的白等
+spring.datasource.hikari.maximum-pool-size=4
+spring.datasource.hikari.connection-timeout=5000
+
+# 4) Flyway：启动时执行 classpath:db/migration 中尚未执行过的迁移。
+#    V1 只在这个数据库第一次使用时执行一次，之后启动只做校验，不会删表重建。
+spring.flyway.enabled=true
+spring.flyway.locations=classpath:db/migration
+spring.flyway.validate-on-migrate=true
+
+# 5) 课程演示账号：admin / manager / viewer 共用本机 DEMO_PASSWORD 作为初始口令。
+#    只从项目根 .env 读取；未提供时启动会明确报出缺项 DEMO_PASSWORD，程序不使用写死的默认口令。
+#    该口令只在启动时生成 BCrypt 摘要写入 users 表，本文件、日志与接口都不保存或输出明文。
+campus.demo.password=${DEMO_PASSWORD:}
+
+# 6) 第09课 Redis 登录会话：只连本机课程容器（127.0.0.1:23502），口令同样只从根 .env 读取。
+#    本课程 Redis 明确关闭了 RDB 与 AOF：重启 redis 后会话消失，学生需要重新登录；
+#    业务数据仍在 MySQL，不由 Redis 承担。
+#    连接与读命令都设短超时：Redis 不可用时尽快返回清楚的结果，而不是让请求长时间挂住。
+spring.data.redis.host=127.0.0.1
+spring.data.redis.port=23502
+spring.data.redis.password=${REDIS_PASSWORD:}
+spring.data.redis.timeout=2s
+spring.data.redis.connect-timeout=2s
+
+# 7) 登录会话：令牌在 Redis 中保留 1800 秒（30 分钟），键前缀 campus:v2:session:。
+#    到期或退出即失效；浏览器只把令牌放在内存里，刷新页面需要重新登录。
+campus.session.ttl-seconds=1800
