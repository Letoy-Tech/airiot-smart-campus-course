+    row.append(idCell, nameCell, ownerCell, noteCell, actionCell);
+    tbody.append(row);
+  }
+
+  const registeredCount = devices.filter((device) =>
+    ownersByDevice.has(device.id)
+  ).length;
+  ownersView.summary.textContent =
+    `已登记 ${registeredCount} 台 / 全部 ${devices.length} 台`;
