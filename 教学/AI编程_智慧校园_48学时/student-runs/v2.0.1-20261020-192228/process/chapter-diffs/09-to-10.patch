+
+    @Test
+    void anonymousIsUnauthorizedBeforeRoleCheck() throws Exception {
+        mockMvc.perform(get("/api/role-demo"))
+                .andExpect(status().isUnauthorized())
+                .andExpect(jsonPath("$.code").value(401));
+    }
+}
