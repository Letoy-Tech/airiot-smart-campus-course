--- 09/campus-lab/frontend/styles.css
+++ 10/campus-lab/frontend/styles.css
@@ -0,0 +1,2305 @@
+    :root {
+      color-scheme: light;
+      --ink: #16222e;
+      --muted: #5d7185;
+      --line: #dbe4ee;
+      --paper: #ffffff;
+      --bg: #eef3fa;
+      --accent: #1f6feb;
+      --accent-soft: #e8f0fe;
+    }
+
+    * {
+      box-sizing: border-box;
+    }
+
+    [hidden] {
+      display: none !important;
+    }
+
+    html,
+    body {
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      min-height: 100vh;
+      font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans SC",
+        system-ui, -apple-system, "Segoe UI", sans-serif;
+      color: var(--ink);
+      background: var(--bg);
+      -webkit-text-size-adjust: 100%;
+    }
+
+    /* 三块结构：顶部标题、左侧菜单、右侧内容 */
+    .layout {
+      display: grid;
+      grid-template-rows: auto 1fr;
+      min-height: 100vh;
+      min-width: 0;
+    }
+
+    .topbar {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: baseline;
+      gap: 4px 14px;
+      padding: 22px 28px;
+      background: var(--paper);
+      border-bottom: 1px solid var(--line);
+    }
+
+    .topbar h1 {
+      margin: 0;
+      font-size: 24px;
+      line-height: 1.35;
+      letter-spacing: 0.01em;
+      overflow-wrap: anywhere;
+    }
+
+    .topbar .tag {
+      margin: 0;
+      font-size: 14px;
+      color: var(--muted);
+    }
+
+    /* 顶部“演示身份”：只切换页面显示，不是登录 */
+    .identity {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: 4px 12px;
+      margin-left: auto;
+      min-width: 0;
+    }
+
+    .identity-field {
+      display: inline-flex;
+      align-items: center;
+      gap: 8px;
+      min-width: 0;
+    }
+
+    .identity-label {
+      font-size: 14px;
+      line-height: 1.5;
+      color: var(--muted);
+      white-space: nowrap;
+    }
+
+    .identity-select {
+      min-height: 36px;
+      min-width: 150px;
+      padding: 0 10px;
+      border: 1px solid #c9d8e9;
+      border-radius: 8px;
+      background: var(--paper);
+      color: var(--ink);
+      font: inherit;
+      font-size: 14px;
+      cursor: pointer;
+    }
+
+    .identity-select:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .identity-note {
+      flex-basis: 100%;
+      margin: 0;
+      font-size: 12px;
+      line-height: 1.6;
+      color: var(--muted);
+      text-align: right;
+      overflow-wrap: anywhere;
+    }
+
+    /* 顶部“后端连接”：只检查 GET /api/health，不切换任何业务数据 */
+    .backend-check {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: 4px 10px;
+      padding: 6px 12px;
+      border: 1px solid var(--line);
+      border-radius: 10px;
+      background: var(--accent-soft);
+    }
+
+    .backend-check-title {
+      font-size: 14px;
+      line-height: 1.5;
+      color: var(--muted);
+      white-space: nowrap;
+    }
+
+    .backend-check-button {
+      min-height: 32px;
+      padding: 0 12px;
+      border: 1px solid #c9d8e9;
+      border-radius: 8px;
+      background: var(--paper);
+      color: var(--ink);
+      font: inherit;
+      font-size: 14px;
+      cursor: pointer;
+    }
+
+    .backend-check-button:hover:not(:disabled) {
+      border-color: var(--accent);
+    }
+
+    .backend-check-button:disabled {
+      color: var(--muted);
+      cursor: progress;
+    }
+
+    .backend-check-button:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .backend-check-status {
+      font-size: 13px;
+      line-height: 1.5;
+      color: var(--muted);
+      overflow-wrap: anywhere;
+    }
+
+    .backend-check-status.is-checking {
+      color: var(--accent);
+    }
+
+    .backend-check-status.is-ok {
+      color: #157f3b;
+    }
+
+    .backend-check-status.is-fail {
+      color: #b3261e;
+    }
+
+    .body {
+      display: flex;
+      align-items: stretch;
+      min-width: 0;
+    }
+
+    /* 左侧菜单 */
+    .sidebar {
+      flex: 0 0 208px;
+      background: var(--paper);
+      border-right: 1px solid var(--line);
+      padding: 16px 12px;
+      min-width: 0;
+    }
+
+    .menu {
+      display: flex;
+      flex-direction: column;
+      gap: 4px;
+      margin: 0;
+      padding: 0;
+      list-style: none;
+    }
+
+    .menu-item {
+      display: flex;
+      align-items: center;
+      width: 100%;
+      min-height: 44px;
+      padding: 0 14px;
+      border: 0;
+      border-radius: 8px;
+      background: transparent;
+      color: var(--ink);
+      font: inherit;
+      font-size: 15px;
+      line-height: 1.4;
+      text-align: left;
+      cursor: pointer;
+      white-space: nowrap;
+    }
+
+    .menu-item:hover {
+      background: #f1f5fb;
+    }
