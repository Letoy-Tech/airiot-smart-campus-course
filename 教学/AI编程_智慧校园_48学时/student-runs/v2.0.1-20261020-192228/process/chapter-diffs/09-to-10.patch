+      overflow-wrap: anywhere;
+    }
+
+    .login-note {
+      margin: 16px 0 0;
+    }
+
+    .login-form {
+      display: flex;
+      flex-direction: column;
+      gap: 14px;
+      max-width: 360px;
+    }
+
+    .login-field {
+      display: flex;
+      flex-direction: column;
+      gap: 6px;
+      min-width: 0;
+    }
+
+    .login-label {
+      font-size: 14px;
+      line-height: 1.5;
+      color: var(--muted);
+    }
+
+    .login-input {
+      min-height: 40px;
+      padding: 0 12px;
+      border: 1px solid #c9d8e9;
+      border-radius: 8px;
+      background: var(--paper);
+      color: var(--ink);
