+    refs.emptyNote.hidden = true;
+    refs.errorBox.hidden = true;
+    return;
+  }
+
+  if (!historyOverview) return;
+
+  const device =
+    historyOverview.devices.find((item) => item && item.id === deviceId) ?? null;
+
+  if (!device) {
