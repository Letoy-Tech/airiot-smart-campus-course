+
+// 保存成功后用回读结果渲染整张责任表，不用 PUT 响应体拼改页面。
+function applyReadBackOwners(owners) {
+  if (!ownersView) return;
+
+  loadedOwners = owners;
+  ownersLoaded = true;
+  renderOwnerRows(loadedOwnerDevices, owners);
+
+  ownersView.status.hidden = true;
+  ownersView.wrap.hidden = false;
