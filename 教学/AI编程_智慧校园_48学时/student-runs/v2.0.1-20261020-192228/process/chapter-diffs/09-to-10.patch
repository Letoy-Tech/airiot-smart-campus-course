+
+function readOverviewAlarm(item, index) {
+  if (item === null || typeof item !== "object" || Array.isArray(item)) {
+    throw overviewError(`第 ${index + 1} 条报警不是对象，已拒绝本次数据`);
+  }
+  const where = `第 ${index + 1} 条报警`;
