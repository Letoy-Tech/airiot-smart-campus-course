+    if (spaces.length === 0) {
+      pendingSpaceTargetId = null;
+      loadedSpaces = [];
+      loadedSpaceDevices = [];
+      setSpacesStatus("没有空间");
+      spacesLoaded = true;
+      return;
+    }
