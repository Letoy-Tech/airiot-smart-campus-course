+async function loadAlarms() {
+  if (!alarmsView || alarmsLoading) return;
+
+  const source = overviewSource();
+
+  // 连接后端但未登录：只显示登录提示；浏览器演示则照旧读公开练习数据。
+  if (source === "backend" && currentUser === null) {
+    showAlarmsLoginRequired();
